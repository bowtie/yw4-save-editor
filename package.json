{
  "name": "yw4-save-editor",
  "version": "1.0.0",
  "description": "Browser-based save editor for Yo-kai Watch 4++ (Nintendo Switch / PS4)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "verify": "vp check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "cuelume": "^0.2.2",
    "framer-motion": "^13.4.0",
    "react": "19",
    "react-dom": "19",
    "slot-text": "^0.3.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "19",
    "@types/react-dom": "19",
    "typescript": "^5.4.0",
    "vite-plus": "0.2.4"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
