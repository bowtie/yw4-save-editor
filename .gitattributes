# Normalize line endings on checkin, keep LF in the working tree.
* text=auto eol=lf

# Binary assets must never be line-ending mangled or diffed as text.
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.bin  binary
*.svg  text eol=lf

# Lockfiles are generated; keep diffs stable.
bun.lock text eol=lf diff=lock